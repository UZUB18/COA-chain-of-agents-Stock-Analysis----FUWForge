# Copy to .env in the project root. Never put a real key in this example.
# Obtain a Gemini Developer API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# GOOGLE_API_KEY is also accepted. Shell environment values take precedence.
# Providers stay opt-in: use --provider gemini for run or monitor.
# OpenCode Go key; if omitted, the local OpenCode auth file is used.
OPENCODE_GO_API_KEY=
# TypeSafe key for the Jev monitor. The monitor's auto mode uses it when present.
TYPESAFE_API_KEY=
# SEC fair-access contact, not an API credential. Use your real organization/email.
SEC_USER_AGENT=
