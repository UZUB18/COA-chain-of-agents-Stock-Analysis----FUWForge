# Python artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/

# Local API keys and secrets
.env
.env.*
!.env.example

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local agent scratch: transcripts can contain conversational secrets, and the
# helper scripts under .pi/ are single-machine probes against live endpoints.
.pi/

# Local skill/tool installs. .gemini/skills/ holds symlinks into $HOME, which
# dangle for anyone who clones this repo.
.gemini/

# Local tool output caches and MCP captures.
graphify-out/
.playwright-mcp/

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE settings
.idea/
.vscode/

# OS-generated files
.DS_Store
Thumbs.db

# Run outputs: working files stay ignored, audit artifacts are committable.
runs/*
!runs/*/
runs/*/a*_envelope.json
runs/*/a*_raw.json
runs/*/run_summary.json
*.log
!runs/*/*_provenance.log

# Cached source bodies (original response bytes) are large, reproducible from
# their manifests, and re-fetchable. Their SHA-256 hashes live in the committed
# evidence.json / envelopes, so verify-run still detects tampering.
*.bytes

# Text extracted from those cached bodies at retrieval time. Regenerated by
# re-fetching; committing them triples repo size for no audit value.
runs/**/D[0-9]*.txt
runs/**/WEB[0-9]*.txt
